#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	pwm_loopback_0 {
		compatible = "test-pwm-loopback";

		/*
		 * NOTE:
		 * The first PWM must come from a 32-bit timer.
		 *
		 * Replace the controller/channel numbers according to
		 * the SF32LB52 reference manual.
		 */
		pwms =
			<&gptim2_pwm 0 0 PWM_POLARITY_NORMAL>,
			<&gptim2_pwm 1 0 PWM_POLARITY_NORMAL>;
	};
};

&pinctrl {
	gptim2_pwm_default: gptim2_pwm_default {
		group1 {
			/*
			 * TODO:
			 * Replace with the actual PWM output pins.
			 */
			pinmux = <
				PA00_GPTIM2_CH1
				PA01_GPTIM2_CH2
			>;
		};
	};
};

&gptim2 {
	status = "okay";

	/* Adjust according to the desired timer clock */
	sifli,prescaler = <0>;

	gptim2_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&gptim2_pwm_default>;
		pinctrl-names = "default";
	};
};