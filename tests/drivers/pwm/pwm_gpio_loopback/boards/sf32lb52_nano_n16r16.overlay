/* Test requires wire connection between:
 *  - GPTIM2_CH1 PWM output at PA00 <-> GPIO input at PA01
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	zephyr,user {
		pwms = <&gptim2_pwm 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
		       <&gptim2_pwm 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
		       <&gptim2_pwm 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
		       <&gptim2_pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;

		gpios = <&gpioa_32_44 7 GPIO_ACTIVE_HIGH>,
			<&gpioa_32_44 6 GPIO_ACTIVE_HIGH>,
			<&gpioa_32_44 8 GPIO_ACTIVE_HIGH>,
			<&gpioa_32_44 11 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	gptim2_pwm_default: gptim2_pwm_default {
		group1 {
			pinmux = <PA37_GPTIM2_CH1
				  PA41_GPTIM2_CH2
				  PA42_GPTIM2_CH3
				  PA44_GPTIM2_CH4>;
		};
	};
};

&gptim2 {
	status = "okay";
	sifli,prescaler = <7>;

	gptim2_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&gptim2_pwm_default>;
		pinctrl-names = "default";
	};
};

&gpioa_00_31 {
	status = "okay";
};
